# WETCOR AI backend configuration (copied to backend/.env by setup-windows.ps1).
# Environment variables of the same name override this file.

# Bind address: keep 127.0.0.1 so the API is reachable only from this computer.
WETCOR_HOST=127.0.0.1
WETCOR_PORT=8100
# Browser origins allowed to call the API (the local frontend only).
WETCOR_CORS_ORIGINS=http://localhost:3100,http://127.0.0.1:3100
# Upload size limit in MB (images and instrument files).
WETCOR_MAX_UPLOAD_MB=25
# Optional: move the data or model folders elsewhere (absolute paths).
# WETCOR_DATA_DIR=D:\wetcor-data
# WETCOR_MODELS_DIR=D:\wetcor-models
